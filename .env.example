# --- required ---
# MongoDB connection string (Atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/
MONGODB_DB=copeemachine
# Google OAuth Web client ID (see README)
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# --- production (set these on the host) ---
# Enforces HTTPS cookies and refuses to start with dev login on; adds HSTS + CSP headers
# APP_ENV=production
# Behind a reverse proxy / PaaS (nginx, Render, Fly, Railway...): trust X-Forwarded-* headers
# TRUST_PROXY=1
# Optional: fixed session-signing key (otherwise generated into ./data/secret). Use this on hosts with no persistent disk.
# SECRET_KEY=<64 random hex chars>

# --- local development ---
PORT=5050
# Defaults to 0 locally and 1 when APP_ENV=production
COOKIE_SECURE=0
# Local testing without Google (never enable in production)
# COPEE_DEV_LOGIN=1

# --- email a note to yourself (SMTP) ---
# Gmail: smtp.gmail.com / 587, and use an App Password (not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Optional; defaults to SMTP_USER
# SMTP_FROM=you@gmail.com

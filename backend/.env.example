# --- required ---
# MongoDB connection string (Atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/
MONGODB_DB=copeemachine
# Google OAuth Web client ID (see README)
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# --- frontend (hosted separately) ---
# Its https origin(s), comma-separated, no trailing slash. Needed whenever the browser calls this API from another origin.
# CORS_ORIGINS=https://your-frontend.example.com
# Lax if frontend and API share a registrable domain (app.example.com + api.example.com);
# None if they are on different sites (two *.onrender.com hosts). None requires HTTPS.
# COOKIE_SAMESITE=Lax

# --- production (set these on the host) ---
# Enforces HTTPS cookies and refuses to start with dev login on; adds HSTS + CSP headers
# APP_ENV=production
# Behind a reverse proxy / PaaS (nginx, Render, Fly, Railway...): trust X-Forwarded-* headers
# TRUST_PROXY=1
# Session-signing key (otherwise generated into ./data/secret). Required on hosts with no persistent disk.
# SECRET_KEY=<64 random hex chars>

# --- local development ---
PORT=5050
# Defaults to 0 locally and 1 when APP_ENV=production
COOKIE_SECURE=0
# Local testing without Google (never enable in production)
# COPEE_DEV_LOGIN=1

# --- email a note to yourself: pick ONE method ---
# A) Gmail API over HTTPS (works on hosts that block SMTP, e.g. Render free). Run scripts/gmail_authorize.py once.
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=printed-by-gmail_authorize.py
GMAIL_SENDER=you@gmail.com
# B) SMTP (local dev). Gmail: smtp.gmail.com / 587 with an App Password. Ignored when GMAIL_REFRESH_TOKEN is set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
